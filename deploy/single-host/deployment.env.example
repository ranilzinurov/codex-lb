# Copy to a host-owned location such as /etc/codex-lb/deployment.env.
# This file contains deployment controls, not application secrets.

# Keep the runtime environment file outside the repository and mode 0600.
DEPLOY_RUNTIME_ENV_FILE=/etc/codex-lb/runtime.env

# Reach this through the production reverse proxy, not the loopback service.
DEPLOY_PUBLIC_READY_URL=https://codex-lb.example.com/health/ready

# The paths below are owned by the deployment workflow.
DEPLOY_STATE_DIR=/var/lib/codex-lb-deploy
DEPLOY_BACKUP_DIR=/var/lib/codex-lb-deploy/backups
DEPLOY_DATA_VOLUME=codex-lb-data
DEPLOY_SQLITE_DATABASE_PATH=/var/lib/codex-lb/store.db

# Refuse a rollout before pull when less than this much host disk is free.
DEPLOY_MIN_FREE_SPACE_MB=2048
DEPLOY_HEALTH_TIMEOUT_SECONDS=180
DEPLOY_REQUEST_TIMEOUT_SECONDS=5
DEPLOY_POLL_INTERVAL_SECONDS=2

# Only files named codex-lb-deploy-*.sqlite in DEPLOY_BACKUP_DIR are retained.
DEPLOY_BACKUP_RETENTION=3
