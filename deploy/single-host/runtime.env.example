# Copy to /etc/codex-lb/runtime.env and set mode 0600.
# This file is read only by Docker Compose and is never committed.

# The single-host contract uses the named volume at /var/lib/codex-lb.
CODEX_LB_DATABASE_URL=sqlite+aiosqlite:////var/lib/codex-lb/store.db
CODEX_LB_ENCRYPTION_KEY_FILE=/var/lib/codex-lb/encryption.key
CODEX_LB_DATABASE_MIGRATE_ON_STARTUP=true

# Set the values required by this installation. Keep tokens, passwords, and
# dashboard bootstrap credentials in this file rather than deployment.env.
# CODEX_LB_DASHBOARD_BOOTSTRAP_TOKEN=replace-with-a-secret
